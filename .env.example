# Copy these into Vercel: Project -> Settings -> Environment Variables, then redeploy.
# NEXT_PUBLIC_* values are baked in at build time, so a redeploy is needed after changing them.
# Everything here is optional; anything left empty is simply switched off.

# Your site address once you have a custom domain (used for canonical links, sitemap, social cards)
NEXT_PUBLIC_SITE_URL=

# Search engine ownership (the "content" value of the HTML-tag verification method)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Optional analytics: each loads ONLY after a visitor accepts the cookie banner
# Google Tag Manager container, like GTM-ABC1234 (recommended: set up GA4 and Clarity inside it)
NEXT_PUBLIC_GTM_ID=
# Google Analytics 4 measurement ID, like G-ABC1234567 (used only when no GTM ID is set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project ID, like abc123xyz9
NEXT_PUBLIC_CLARITY_ID=
